# Copy outside the source tree. This file is for docker run, never docker build.
# Use one key. Values are not shell expressions; do not add shell quotes.
CODEX_API_KEY=
# OPENAI_API_KEY=

# Optional Responses-compatible gateway. In bridge mode, host loopback is:
# OPENAI_BASE_URL=http://host.docker.internal:6000/v1
# To use 127.0.0.1 directly, explicitly choose --network host on Linux.

# Runtime proxies are explicit; host proxy variables are not inherited at run time.
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
